#!/usr/bin/python
# -*- mode: python; coding: utf-8 -*-

import sys
import argparse

from EasyXBee import LocalNode


class Receiver:
    def __init__(self, args):
        self.local = LocalNode(tty=args.device, speed=args.speed)
        if args.panid:
            self.local.set_pan_id(args.panid)

    def run(self):
        print "Waiting events..."

        while True:
            try:
                print list(self.local.receive())
            except KeyboardInterrupt:
                print "\rBye!"
                break


if __name__ == "__main__":

    parser = argparse.ArgumentParser(
        description = "Receive data from other XBee node")

    parser.add_argument('-d', dest='device', default="/dev/ttyUSB1",
                        help="device where my XBee is attached")
    parser.add_argument('-b', dest='speed', default="9600",
                        help="Speed for serial device")

    parser.add_argument('-p', dest='panid', default="",
                        help="PAN identifier on wich search node")

    args = parser.parse_args()
    s = Receiver(args)
    s.run()
