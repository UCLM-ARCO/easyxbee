#!/usr/bin/python3
# -*- mode: python; coding: utf-8 -*-

import sys
import argparse

from EasyXBee import LocalNode


class Discoverer:
    def __init__(self, device, speed):
        self._device = device
        self.local = LocalNode(tty=device, speed=speed)

    def run(self):
        print("Device: '{}'".format(self._device))
        print("Discovering...", end=' ')
        sys.stdout.flush()

        neighbors = self.local.discover()
        print(" Done")
        self.printResults(neighbors)

    def printResults(self, neighbors):
        if not neighbors:
            print("No neighbors found!")
            return

        print("Results:")
        for i, n in enumerate(neighbors):
            print("{}: {}".format(i, n))


if __name__ == "__main__":

    parser = argparse.ArgumentParser(
        description = "Discover other nodes")

    parser.add_argument('-d', dest='device', default="/dev/ttyUSB1",
                        help="device where my XBee is attached")
    parser.add_argument('-b', dest='speed', default="9600",
                        help="Speed for serial device")

    args = parser.parse_args()
    s = Discoverer(args.device, args.speed)
    s.run()
